# ERPTemplate — shared formatting rules (C# + TypeScript + SQL)
# See DEVELOPMENT-GUIDELINES.md section 8 (Coding Standards).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ------------------------------- C# / .NET -----------------------------------
[*.{cs,csx}]
indent_style = space
indent_size = 4
max_line_length = 140
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_style_namespace_declarations = block_scoped:silent
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = suggestion   # remove unnecessary usings

[*.csproj]
indent_style = space
indent_size = 2

[*.sln]
indent_style = tab

# --------------------------- TypeScript / Angular ----------------------------
[*.ts]
indent_style = space
indent_size = 2
quote_type = single
ij_typescript_use_double_quotes = false

[*.{html,css,scss,json,yml,yaml}]
indent_style = space
indent_size = 2

# --------------------------------- SQL ---------------------------------------
[*.{sql,ddl}]
indent_style = space
indent_size = 4

# ------------------------------- Markdown ------------------------------------
[*.md]
max_line_length = off
trim_trailing_whitespace = false
